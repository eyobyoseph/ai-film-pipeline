{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Short Film Storyboard",
  "type": "object",
  "required": ["project_title", "proverb", "aspect_ratio", "target_fps", "music_style_prompt", "characters", "shots"],
  "additionalProperties": false,
  "properties": {
    "project_title": { "type": "string", "minLength": 3 },
    "proverb": { "type": "string", "minLength": 3 },
    "aspect_ratio": { "type": "string", "enum": ["9:16", "16:9"] },
    "target_fps": { "type": "integer", "enum": [24, 30] },
    "music_style_prompt": { "type": "string", "minLength": 10 },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 10 }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "duration_sec",
          "narration_amharic",
          "subtitle_en",
          "image_prompt",
          "motion_prompt",
          "music_cue"
        ],
        "additionalProperties": false,
        "properties": {
          "shot_id": { "type": "string", "pattern": "^shot_[0-9]{2}$" },
          "duration_sec": { "type": "number", "minimum": 4, "maximum": 12 },
          "narration_amharic": { "type": "string", "minLength": 5 },
          "subtitle_en": { "type": "string", "minLength": 5 },
          "image_prompt": { "type": "string", "minLength": 20 },
          "motion_prompt": { "type": "string", "minLength": 10 },
          "music_cue": { "type": "string", "minLength": 5 }
        }
      }
    }
  }
}